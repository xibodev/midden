          "goal": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "key_points": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "attachments": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Paths relative to the seed root. Never absolute, never referencing Midden internals."
          },
          "suggested_output_types": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Advisory. An unrecognised value degrades to no suggestion rather than failing the seed."
          },
          "evidence_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "evidence_count": {
            "type": "integer",
            "minimum": 0
