# Normalise line endings so the repo is identical on every platform.
* text=auto eol=lf

*.go     text eol=lf
*.md     text eol=lf
*.mod    text eol=lf
*.sum    text eol=lf
Makefile text eol=lf

# PowerShell is only ever run on Windows.
*.ps1 text eol=crlf

# Never munge binaries.
*.png binary
*.jpg binary
*.exe binary
*.db  binary
